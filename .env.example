# App
NODE_ENV=development
CRON_SECRET="change-me"

# Database
# Do not point this at a real PostgreSQL database until migrations are approved.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_TEXT_MODEL="gpt-5.4-nano"
OPENAI_VISION_MODEL="gpt-5.4-nano"
OPENAI_TIMEOUT_MS=30000

# Scraping
SCRAPER_USER_AGENT="MSA product research bot; contact owner before increasing crawl volume"
SCRAPER_MAX_REQUESTS_PER_MINUTE=20
SCRAPER_TIMEOUT_MS=10000
