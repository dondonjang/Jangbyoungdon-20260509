// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ScrapePageKind {
  PLP
  PDP
  UNKNOWN
}

enum ScrapeSource {
  HTML
  MARKET_API
  NEXT_DATA
  BROWSER
}

enum ScrapeStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum ProductInputStatus {
  PENDING
  SCRAPING
  SCRAPED
  ANALYZED
  FAILED
}

enum ProductAttributeKind {
  ATTRIBUTE
  BENEFIT
}

enum ProductRelationKind {
  SAME_PRODUCT
  RECOMMENDED_PRODUCT
}

enum UserProductStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum ProductInputKind {
  NAME
  URL
}

/// AI provider 호출 로그
model AiRequestLog {
  /// 내부 ID
  id           Int       @id @default(autoincrement())
  /// provider 이름(openai, claude, gemini 등)
  provider     String
  /// 작업 구분(PRODUCT_KEYWORDS, PRODUCT_ATTRIBUTES, OCR 등)
  task         String
  /// 호출 모델명
  model        String
  /// SUCCESS/FAILED
  status       String
  /// 입력 데이터
  input        Json
  /// 출력 데이터
  output       Json?
  /// 에러 메시지
  errorMessage String?
  /// 프롬프트/스키마 버전 추적용 해시
  promptHash   String?
  /// 응답 소요 시간(ms)
  latencyMs    Int?
  /// 토큰/비용 등 provider 응답 메타
  responseMeta Json?
  /// 시작 시각
  startedAt    DateTime  @default(now())
  /// 종료 시각
  finishedAt   DateTime?
  /// 생성 시각
  createdAt    DateTime  @default(now())
  /// 수정 시각
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([provider, task, status])
  @@index([model])
  @@index([createdAt])
  @@map("ai_request_logs")
}

/// 수집 대상 마켓 설정
model Market {
  id                       Int      @id @default(autoincrement())
  slug                     String   @unique
  companyName              String
  displayName              String
  baseUrl                  String
  apiBaseUrl               String?
  renderingMode            String
  botDetectionLevel        String
  botDetectionLogic        Json
  recommendedProxyStrategy String
  recommendedProxy         Json
  requestPolicy            Json
  scrapeStrategy           Json
  enabled                  Boolean  @default(true)
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt

  scrapeLogs     ScrapeLog[]
  outboundClicks OutboundClick[]

  @@map("markets")
}

/// 서비스 사용자
model User {
  id        Int      @id @default(autoincrement())
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  products       UserProduct[]
  outboundClicks OutboundClick[]

  @@map("users")
}

/// 주기적으로 확인할 수집 대상 URL
model ScrapeTarget {
  /// 내부 ID
  id          Int      @id @default(autoincrement())
  /// 마켓 식별명(kurly, danawa 등)
  marketName  String
  /// 원본 URL
  url         String
  /// PLP/PDP/SEARCH 등 링크 종류
  linkType    String
  /// 수집 카테고리
  category    String?
  /// 수집 대상 설명
  description String?
  /// 활성 여부
  enabled     Boolean  @default(true)
  /// 생성 시각
  createdAt   DateTime @default(now())
  /// 수정 시각
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([marketName, url])
  @@index([marketName, linkType, enabled])
  @@index([category])
  @@map("scrape_targets")
}

/// 수집 실행 로그와 원본 응답 저장
model ScrapeLog {
  /// 내부 ID
  id            Int       @id @default(autoincrement())
  /// 마켓 ID
  marketId      Int?
  /// 마켓 식별명(kurly, danawa 등)
  marketName    String
  /// 사용자가 입력하거나 스케줄에서 가져온 URL
  inputUrl      String
  /// 실제 호출한 최종 URL
  finalUrl      String
  /// PLP/PDP/SEARCH 등 페이지 종류
  pageKind      String
  /// HTML/MARKET_API/BROWSER 등 수집 방식
  source        String
  /// SUCCESS/FAILED 등 실행 상태
  status        String    @default("PENDING")
  /// HTTP status code
  statusCode    Int?
  /// 응답 content-type
  contentType   String?
  /// 요청 메타
  request       Json?
  /// 응답 메타
  responseMeta  Json?
  /// HTML 원본
  html          String?
  /// JSON 원본
  rawJson       Json?
  /// 실패 메시지
  errorMessage  String?
  /// 파서 버전
  parserVersion String?
  /// 시작 시각
  startedAt     DateTime  @default(now())
  /// 종료 시각
  finishedAt    DateTime?
  /// 생성 시각
  createdAt     DateTime  @default(now())
  /// 수정 시각
  updatedAt     DateTime  @default(now()) @updatedAt

  market   Market?          @relation(fields: [marketId], references: [id], onDelete: SetNull)
  products Product[]
  listings ProductListing[]

  @@index([marketName, pageKind, status])
  @@index([finalUrl])
  @@index([createdAt])
  @@map("scrape_logs")
}

/// 사용자 입력 상품의 분석/비교 기준이 되는 마스터 상품
model ProductMaster {
  /// 내부 ID
  id              Int      @id @default(autoincrement())
  /// 정규화 상품명
  normalizedName  String
  /// 화면 노출 상품명
  displayName     String
  /// OpenAI가 정제한 상품명
  refinedName     String?
  /// 브랜드
  brand           String?
  /// 대표 카테고리
  category        String?
  /// 상품 요약
  summary         String?
  /// 동일 상품 매칭용 키
  matchKey        String?
  /// 분석 상태
  analysisStatus  String   @default("pending")
  /// 동일 상품 검색 키워드 목록
  sameKeywords    Json     @default("[]")
  /// 연관 상품 검색 키워드 목록
  relatedKeywords Json     @default("[]")
  /// 원본/보조 데이터
  raw             Json?
  /// 생성 시각
  createdAt       DateTime @default(now())
  /// 수정 시각
  updatedAt       DateTime @default(now()) @updatedAt

  inputLinks        ProductInputLink[]
  products          Product[]
  analyses          ProductAnalysis[]
  userProducts      UserProduct[]
  productRelations  ProductRelation[]
  productLinks      ProductLink[]
  productLinkOffers ProductLinkOffer[]
  outboundClicks    OutboundClick[]

  @@unique([matchKey])
  @@index([normalizedName])
  @@index([brand])
  @@map("product_masters")
}

/// 마스터 상품 기준 외부 추천/가격비교 링크 후보
model ProductLink {
  /// 내부 ID
  id              Int      @id @default(autoincrement())
  /// 기준 마스터 상품 ID
  masterId        Int
  /// 연결된 상품 ID
  productId       Int?
  /// 마켓 식별명(kurly, danawa 등)
  marketName      String
  /// 마켓 상품 번호 또는 광고 노출 ID
  marketProductNo String
  /// 마켓 아이템/판매처 번호
  marketItemNo    String?
  /// 다나와 광고/카탈로그에서 노출된 실제 쇼핑몰 코드
  mallCode        String?
  /// 다나와 광고/카탈로그에서 노출된 실제 쇼핑몰명
  mallName        String?
  /// 링크 종류(DANAWA_CATALOG, DANAWA_AD_CATALOG, DANAWA_AD_DIRECT 등)
  linkType        String
  /// 동일 상품/추천 상품 구분
  relationKind    String
  /// 검색에 사용한 키워드
  searchKeyword   String?
  /// 외부 이동 URL
  sourceUrl       String
  /// 수집 시점 상품명
  name            String
  /// 수집 시점 이미지 URL
  imageUrl        String?
  /// 수집 시점 가격
  price           Int?
  /// 카탈로그/카테고리 후보 여부
  isCatalog       Boolean  @default(false)
  /// 다나와 등 검색 결과의 카테고리명
  categoryName    String?
  /// 카탈로그/검색 결과 기준 판매처 수
  mallCount       Int?
  /// 검색 결과 기준 리뷰 수
  reviewCount     Int?
  /// 검색 결과 기준 평점
  rating          Float?
  /// 검색 결과 기준 스펙/요약
  summary         String?
  /// 검색 결과 노출 순서
  listingOrder    Int?
  /// 광고/스폰서 노출 여부
  isAd            Boolean  @default(false)
  /// 원본/보조 데이터
  raw             Json?
  /// 생성 시각
  createdAt       DateTime @default(now())
  /// 수정 시각
  updatedAt       DateTime @default(now()) @updatedAt

  master  ProductMaster      @relation(fields: [masterId], references: [id], onDelete: Cascade)
  product Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  offers  ProductLinkOffer[]

  @@unique([masterId, marketName, marketProductNo, marketItemNo])
  @@index([masterId, relationKind, listingOrder])
  @@index([marketName, linkType, isAd])
  @@map("product_links")
}

/// 카탈로그/검색 링크 하위의 실제 판매처 링크 후보
model ProductLinkOffer {
  /// 내부 ID
  id              Int      @id @default(autoincrement())
  /// 기준 마스터 상품 ID
  masterId        Int
  /// 상위 후보 링크 ID
  parentLinkId    Int
  /// 연결된 실제 상품 ID
  productId       Int?
  /// 판매처 마켓 식별명(coupang, gmarket 등)
  marketName      String
  /// 판매처 상품 번호
  marketProductNo String
  /// 판매처 아이템/옵션 번호
  marketItemNo    String?
  /// 판매처 화면 노출명
  mallName        String
  /// 판매자명
  sellerName      String?
  /// 외부 이동 URL
  sourceUrl       String
  /// 수집 시점 상품명
  name            String
  /// 수집 시점 이미지 URL
  imageUrl        String?
  /// 수집 시점 가격
  price           Int?
  /// 배송비
  shippingFee     Int?
  /// 배송비 포함 최종가
  finalPrice      Int?
  /// 배송/혜택 문구
  deliveryText    String?
  /// 판매/재고 상태
  availability    String?
  /// 카탈로그 내 노출 순서
  listingOrder    Int?
  /// 광고/스폰서 여부
  isAd            Boolean  @default(false)
  /// 원본/보조 데이터
  raw             Json?
  /// 생성 시각
  createdAt       DateTime @default(now())
  /// 수정 시각
  updatedAt       DateTime @default(now()) @updatedAt

  master     ProductMaster @relation(fields: [masterId], references: [id], onDelete: Cascade)
  parentLink ProductLink   @relation(fields: [parentLinkId], references: [id], onDelete: Cascade)
  product    Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([parentLinkId, marketName, marketProductNo, marketItemNo])
  @@index([masterId, listingOrder])
  @@index([marketName, price])
  @@map("product_link_offers")
}

/// 사용자가 최초 입력한 상품 링크
model ProductInputLink {
  /// 내부 ID
  id           Int                @id @default(autoincrement())
  /// 연결된 마스터 상품 ID
  masterId     Int
  /// 최초 수집된 실제 상품 ID
  productId    Int?
  /// 사용자가 입력한 원본 URL
  inputUrl     String
  /// 입력 URL 중복 체크용 정규화 키
  inputUrlKey  String
  /// 입력 링크 처리 상태
  status       ProductInputStatus @default(PENDING)
  /// 처리 실패 사유
  errorMessage String?
  /// 원본/보조 데이터
  raw          Json?
  /// 생성 시각
  createdAt    DateTime           @default(now())
  /// 수정 시각
  updatedAt    DateTime           @default(now()) @updatedAt

  master  ProductMaster @relation(fields: [masterId], references: [id], onDelete: Cascade)
  product Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([inputUrlKey])
  @@index([masterId, status])
  @@map("product_input_links")
}

/// 마켓별 실제 상품/카탈로그 링크
model Product {
  /// 내부 ID
  id                Int      @id @default(autoincrement())
  /// 연결된 마스터 상품 ID
  masterId          Int?
  /// 수집 로그 ID
  scrapeLogId       Int?
  /// 마켓 식별명(kurly, danawa 등)
  marketName        String
  /// 마켓 상품 번호
  marketProductNo   String
  /// 마켓 아이템/옵션 번호
  marketItemNo      String?
  /// 상품 원본 URL
  sourceUrl         String
  /// 상품명
  name              String
  /// 대표 이미지 URL
  imageUrl          String
  /// 판매가
  price             Int
  /// PLP 페이지 번호
  listingPage       Int?
  /// PLP 기준 전체 노출 순서
  listingOrder      Int?
  /// 리뷰 수
  reviewCount       Int      @default(0)
  /// 평균 별점
  rating            Float?
  /// 리뷰 요약
  reviewSummary     String?
  /// 목록/검색 결과에서 수집한 짧은 상품 소개
  summary           String?
  /// 상품 설명
  description       String?
  /// 상품 상세 이미지 URL 목록
  descriptionImages Json     @default("[]")
  /// 상품정보고시 key-value 목록
  noticeItems       Json     @default("[]")
  /// 수집 상태
  scrapeStatus      String   @default("READY")
  /// 생성 시각
  createdAt         DateTime @default(now())
  /// 수정 시각
  updatedAt         DateTime @default(now()) @updatedAt

  master            ProductMaster?     @relation(fields: [masterId], references: [id], onDelete: SetNull)
  scrapeLog         ScrapeLog?         @relation(fields: [scrapeLogId], references: [id], onDelete: SetNull)
  inputLinks        ProductInputLink[]
  productLinks      ProductLink[]
  productLinkOffers ProductLinkOffer[]
  attributes        ProductAttribute[]
  relationsFrom     ProductRelation[]  @relation("ProductRelationSource")
  relationsTo       ProductRelation[]  @relation("ProductRelationTarget")
  outboundClicks    OutboundClick[]
  listings          ProductListing[]

  @@unique([marketName, marketProductNo])
  @@index([masterId])
  @@index([marketName, scrapeStatus])
  @@index([marketName, listingOrder])
  @@index([marketName, marketItemNo])
  @@index([name])
  @@map("products")
}

/// PLP/검색 결과의 정렬 기준별 상품 노출 순서
model ProductListing {
  /// 내부 ID
  id              Int      @id @default(autoincrement())
  /// 연결된 상품 ID
  productId       Int?
  /// 수집 로그 ID
  scrapeLogId     Int?
  /// 마켓 식별명(kurly, danawa 등)
  marketName      String
  /// 카테고리 번호
  categoryNo      String
  /// 카테고리명
  categoryName    String?
  /// 정렬 타입 코드
  sortType        String
  /// 정렬 타입명
  sortName        String
  /// 페이지 번호
  page            Int
  /// 페이지당 상품 수
  perPage         Int
  /// 페이지 내 노출 순서
  pageOrder       Int
  /// 정렬 기준별 전체 노출 순서
  listingOrder    Int
  /// 마켓 상품 번호
  marketProductNo String
  /// 상품 원본 URL
  sourceUrl       String
  /// 수집 시점 상품명
  name            String
  /// 수집 시점 판매가
  price           Int
  /// 생성 시각
  createdAt       DateTime @default(now())
  /// 수정 시각
  updatedAt       DateTime @default(now()) @updatedAt

  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  scrapeLog ScrapeLog? @relation(fields: [scrapeLogId], references: [id], onDelete: SetNull)

  @@unique([marketName, categoryNo, sortType, marketProductNo])
  @@unique([marketName, categoryNo, sortType, listingOrder])
  @@index([productId])
  @@index([marketName, categoryNo, sortType, page])
  @@map("product_listings")
}

/// 외부 상품 링크 클릭 로그
model OutboundClick {
  /// 내부 ID
  id                Int      @id @default(autoincrement())
  /// 클릭한 사용자 ID
  userId            Int?
  /// 클릭이 발생한 마스터 상품 ID
  masterId          Int?
  /// 클릭한 실제 상품 ID
  productId         Int?
  /// 클릭한 상품의 마켓 ID
  marketId          Int?
  /// 외부 이동 URL
  url               String
  /// URL 집계용 정규화 키
  urlKey            String
  /// 클릭 출처 UI 영역
  source            String?
  /// 클릭 위치
  position          String?
  /// 클릭 당시 상품명
  productTitle      String?
  /// 클릭 당시 마켓명
  marketDisplayName String?
  /// 클릭 당시 판매가
  price             Int?
  /// 클릭 당시 정가
  retailPrice       Int?
  /// 클릭 당시 배송비
  shippingFee       Int?
  /// 클릭 당시 최종가
  finalPrice        Int?
  /// 통화
  currency          String   @default("KRW")
  /// 클릭 당시 판매/재고 상태
  availability      String?
  /// 클릭 당시 판매자명
  sellerName        String?
  /// 클릭 직전 화면
  referrer          String?
  /// 브라우저 user-agent
  userAgent         String?
  /// 추가 컨텍스트
  metadata          Json?
  /// 생성 시각
  createdAt         DateTime @default(now())
  /// 수정 시각
  updatedAt         DateTime @default(now()) @updatedAt

  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  master  ProductMaster? @relation(fields: [masterId], references: [id], onDelete: SetNull)
  market  Market?        @relation(fields: [marketId], references: [id], onDelete: SetNull)
  product Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([masterId, createdAt])
  @@index([marketId, createdAt])
  @@index([productId, createdAt])
  @@index([urlKey])
  @@map("outbound_clicks")
}

/// 상품 속성/베네핏 key-value 데이터
model ProductAttribute {
  /// 내부 ID
  id          Int                  @id @default(autoincrement())
  /// 상품 ID
  productId   Int
  /// 속성/베네핏 구분
  kind        ProductAttributeKind @default(ATTRIBUTE)
  /// 속성 그룹
  group       String               @default("default")
  /// 원본 속성명
  rawKey      String?
  /// 정규화 키
  key         String
  /// 화면 노출 라벨
  label       String?
  /// 원본 값
  value       String
  /// 숫자형 값
  valueNumber Float?
  /// 단위
  unit        String?
  /// 원본/보조 데이터
  raw         Json?
  /// 생성 시각
  createdAt   DateTime             @default(now())
  /// 수정 시각
  updatedAt   DateTime             @default(now()) @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, kind, group, key])
  @@index([key])
  @@map("product_attributes")
}

/// 동일 상품 또는 추천 상품 연결 관계
model ProductRelation {
  /// 내부 ID
  id              Int                 @id @default(autoincrement())
  /// 기준 마스터 상품 ID
  masterId        Int
  /// 기준 상품 ID
  sourceProductId Int?
  /// 연결 대상 상품 ID
  targetProductId Int
  /// 동일 상품/추천 상품 구분
  kind            ProductRelationKind
  /// 유사도 점수
  similarityScore Float?
  /// 연결 이유
  reason          String?
  /// 원본/보조 데이터
  raw             Json?
  /// 생성 시각
  createdAt       DateTime            @default(now())
  /// 수정 시각
  updatedAt       DateTime            @default(now()) @updatedAt

  master        ProductMaster @relation(fields: [masterId], references: [id], onDelete: Cascade)
  sourceProduct Product?      @relation("ProductRelationSource", fields: [sourceProductId], references: [id], onDelete: SetNull)
  targetProduct Product       @relation("ProductRelationTarget", fields: [targetProductId], references: [id], onDelete: Cascade)

  @@unique([masterId, targetProductId, kind])
  @@index([masterId, kind])
  @@map("product_relations")
}

/// 사용자가 저장한 상품 목록
model UserProduct {
  /// 내부 ID
  id          Int               @id @default(autoincrement())
  /// 사용자 ID
  userId      Int
  /// 저장한 마스터 상품 ID
  masterId    Int
  /// 최초 입력 종류
  inputKind   ProductInputKind
  /// 최초 입력값
  sourceValue String
  /// 사용자 화면 노출명
  displayName String
  /// 저장 상태
  status      UserProductStatus @default(ACTIVE)
  /// 사용자 태그
  tags        Json              @default("[]")
  /// 사용자 메모
  memo        String?
  /// 생성 시각
  createdAt   DateTime          @default(now())
  /// 수정 시각
  updatedAt   DateTime          @default(now()) @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  master ProductMaster @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@index([userId, status, updatedAt])
  @@index([userId, masterId, status])
  @@map("user_products")
}

/// OpenAI 등 분석 실행 결과
model ProductAnalysis {
  /// 내부 ID
  id          Int              @id @default(autoincrement())
  /// 분석 대상 마스터 상품 ID
  masterId    Int
  /// 분석 입력값
  sourceValue String
  /// 입력 종류
  inputKind   ProductInputKind
  /// 분석 요약
  summary     String
  /// 사용 모델명
  model       String?
  /// 프롬프트 해시
  promptHash  String?
  /// 분석 입력 원본
  rawInput    Json?
  /// 분석 출력 원본
  rawOutput   Json?
  /// 생성 시각
  createdAt   DateTime         @default(now())
  /// 수정 시각
  updatedAt   DateTime         @default(now()) @updatedAt

  master ProductMaster @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@index([masterId, createdAt])
  @@map("product_analyses")
}
